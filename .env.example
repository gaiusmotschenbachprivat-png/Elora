# =====================================================================
# ELORA – Umgebungsvariablen
# Öffentliche Variablen (NEXT_PUBLIC_*) landen im Browser-Bundle.
# Geheime Schlüssel gehören AUSSCHLIESSLICH in die Supabase-Secrets
# (supabase secrets set …), niemals in NEXT_PUBLIC_* oder ins Repository.
# =====================================================================

# --- Website (Next.js) ----------------------------------------------
# Öffentliche URL inkl. Unterpfad, z. B. https://www.elora.de
NEXT_PUBLIC_SITE_URL=

# Supabase-Projekt (Project Settings → API). Der Anon-Key ist öffentlich;
# der Datenzugriff ist über Row Level Security abgesichert.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auf 1 setzen, sobald Stripe + Checkout-Funktion eingerichtet sind.
# Zusätzlich müssen Preis, Füllmenge, Versandkosten und alle Rechtstexte
# in src/config/shop.ts freigegeben sein – sonst bleibt der Launch-Modus aktiv.
NEXT_PUBLIC_PAYMENTS_ENABLED=0

# Nur für statische Builds (GitHub Pages):
# STATIC_EXPORT=1
# BASE_PATH=/Elora

# --- Supabase Edge Functions (supabase secrets set NAME=wert) --------
# SUPABASE_URL und SUPABASE_SERVICE_ROLE_KEY stellt Supabase automatisch bereit.
#
# SITE_URL=https://www.elora.de              # für Stripe-Rücksprung-URLs
# ALLOWED_ORIGINS=https://www.elora.de       # CORS, kommagetrennt
#
# Checkout erst nach rechtlicher Prüfung freigeben:
# CHECKOUT_ENABLED=true
# STRIPE_SECRET_KEY=sk_live_…                # bzw. sk_test_… zum Testen
# STRIPE_WEBHOOK_SECRET=whsec_…
#
# Brevo (Launch-Registrierung, Newsletter mit Double-Opt-in, Bestellbestätigung):
# BREVO_API_KEY=
# BREVO_LAUNCH_LIST_ID=
# BREVO_NEWSLETTER_LIST_ID=
# BREVO_DOI_TEMPLATE_ID=
# BREVO_DOI_REDIRECT_URL=https://www.elora.de/vormerken/bestaetigt/
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=ELORA
