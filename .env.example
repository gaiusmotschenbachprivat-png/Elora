# Öffentliche Basis-URL der Website (für Canonical, Sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Newsletter-Integration (serverseitig, wird nie an den Browser ausgeliefert).
# Solange keine Variable gesetzt ist, nimmt das Formular KEINE Anmeldungen an
# und zeigt einen ehrlichen Hinweis statt einer simulierten Erfolgsmeldung.
#
# Option A – Brevo (Double-Opt-in empfohlen):
# BREVO_API_KEY=
# BREVO_LIST_ID=
# BREVO_DOI_TEMPLATE_ID=
# BREVO_DOI_REDIRECT_URL=https://www.example.com/?vormerkung=bestaetigt
#
# Option B – generischer Webhook (z. B. Make, Zapier, eigenes Backend):
# NEWSLETTER_WEBHOOK_URL=
# NEWSLETTER_WEBHOOK_SECRET=
